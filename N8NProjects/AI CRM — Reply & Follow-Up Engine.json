    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze this prospect reply.\n\nSender:\n{{ $('Extract Reply Data').item.json.sender_email }}\n\nReply:\n{{ $('Extract Reply Data').item.json.email_body }}\n\nReturn this exact JSON structure:\n\n{\n \"Subject\": \"\",\n  \"reply_type\": \"\",\n  \"intent\": \"\",\n  \"needs_human\": false,\n  \"recommended_action\": \"\"\n}",
        "options": {
          "systemMessage": "You are an AI Sales Reply Classification Agent.\n\nYour job is to analyze an incoming email reply from a sales prospect.\n\nClassify the reply into exactly ONE of these categories:\n\nPOSITIVE\nNEGATIVE\nQUESTION\nNOT_NOW\nUNSUBSCRIBE\nOUT_OF_OFFICE\nUNKNOWN\n\nDefinitions:\n\nPOSITIVE:\nThe prospect shows interest, wants to discuss the service, asks for a meeting, asks for pricing, or wants more information.\n\nNEGATIVE:\nThe prospect clearly rejects the offer or says they are not interested.\n\nQUESTION:\nThe prospect asks a question but does not clearly indicate positive or negative intent.\n\nNOT_NOW:\nThe prospect is interested but asks to be contacted at a later time.\n\nUNSUBSCRIBE:\nThe prospect asks to stop receiving emails or asks to be removed from future communication.\n\nOUT_OF_OFFICE:\nThe message is an automated out-of-office or vacation response.\n\nUNKNOWN:\nThe intent cannot be determined reliably.\n\nRules:\n- Do not invent information.\n- Analyze only the actual incoming reply.\n- If the prospect explicitly asks to stop emails, always classify as UNSUBSCRIBE.\n- If the prospect expresses interest and asks for a meeting, classify as POSITIVE.\n- Return ONLY valid JSON."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        896,
        640
      ],
      "id": "f57d020c-8b92-42f8-8fe6-0270cd090560",
      "name": "AI Reply Classifier"
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.output || \"\";\n\nlet parsed;\n\ntry {\n  parsed = JSON.parse(raw);\n} catch (error) {\n  throw new Error(\"AI returned invalid JSON: \" + raw);\n}\n\nconst replyType = String(parsed.reply_type || \"UNKNOWN\").toUpperCase();\n\nlet intent = parsed.intent || \"UNKNOWN\";\nlet needsHuman = false;\nlet recommendedAction = \"\";\n\nswitch (replyType) {\n  case \"POSITIVE\":\n    intent = \"HIGH\";\n    needsHuman = true;\n    recommendedAction = \"Notify sales team and schedule a discovery call.\";\n    break;\n\n  case \"QUESTION\":\n    intent = \"MEDIUM\";\n    needsHuman = true;\n    recommendedAction = \"Review the prospect's question and send an appropriate response.\";\n    break;\n\n  case \"NOT_NOW\":\n    intent = \"MEDIUM\";\n    needsHuman = false;\n    recommendedAction = \"Schedule a follow-up for the requested time.\";\n    break;\n\n  case \"NEGATIVE\":\n    intent = \"LOW\";\n    needsHuman = false;\n    recommendedAction = \"Stop the active follow-up sequence.\";\n    break;\n\n  case \"UNSUBSCRIBE\":\n    intent = \"NONE\";\n    needsHuman = false;\n    recommendedAction = \"Stop all future outreach immediately.\";\n    break;\n\n  case \"OUT_OF_OFFICE\":\n    intent = \"UNKNOWN\";\n    needsHuman = false;\n    recommendedAction = \"Wait and retry after the expected return date.\";\n    break;\n\n  default:\n    intent = \"UNKNOWN\";\n    needsHuman = true;\n    recommendedAction = \"Review the reply manually.\";\n}\n\nreturn [\n  {\n    json: {\n      reply_type: replyType,\n      intent: intent,\n      needs_human: needsHuman,\n      recommended_action: recommendedAction,\n\n      original_reply: $('Extract Reply Data').item.json.email_body,\n      sender_email: $('Extract Reply Data').item.json.sender_email,\n      subject: $('Extract Reply Data').item.json.subject\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1248,
        640
      ],
      "id": "16416ab6-9595-43c1-8484-cdaa6fc75742",
