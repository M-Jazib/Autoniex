      "parameters": {
        "jsCode": "const data = $json;\n\nconst from = data.From || \"\";\n\nconst emailMatch = from.match(/<([^>]+)>/);\n\nconst sender_email = emailMatch\n  ? emailMatch[1]\n  : from.trim();\n\nconst labels = data.labels || [];\n\nconst is_sent = labels.some(\n  label => label.name === \"SENT\"\n);\n\nconst is_inbox = labels.some(\n  label => label.name === \"INBOX\"\n);\n\nreturn [\n  {\n    json: {\n      sender_email,\n      sender_name: from.replace(/<[^>]+>/, \"\").trim(),\n      subject: data.Subject || \"\",\n      message_id: data.id || \"\",\n      thread_id: data.threadId || \"\",\n      email_body: data.snippet || \"\",\n      is_sent,\n      is_inbox,\n      received_at: data.internalDate\n        ? new Date(Number(data.internalDate)).toISOString()\n        : new Date().toISOString()\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
