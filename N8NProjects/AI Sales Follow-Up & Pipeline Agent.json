    {
      "parameters": {
        "jsCode": "const raw = $json.output || $json.text || \"\";\n\nlet data;\n\ntry {\n  data = JSON.parse(raw);\n} catch (error) {\n  const match = raw.match(/\\{[\\s\\S]*\\}/);\n\n  if (!match) {\n    throw new Error(\"AI output is not valid JSON\");\n  }\n\n  data = JSON.parse(match[0]);\n}\n\nreturn [{\n  json: {\n    subject: data.subject || \"\",\n    email_body: data.email_body || \"\",\n    reason_for_followup: data.reason_for_followup || \"\",\n    suggested_next_step: data.suggested_next_step || \"\"\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        -176
      ],
      "id": "901c3d6e-a5c5-4c2d-abc4-60086bea1fa6",
      "name": "Parse Follow-Up"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Deal Information:\n\nDeal ID: {{ $json.deal_id }}\nDeal Name: {{ $json.deal_name }}\nAmount: {{ $json.amount }}\nDeal Stage: {{ $json.deal_stage }}\nInactive Days: {{ $json.inactive_days }}\nStatus: {{ $json.status }}\n\nContact Information:\n\nFirst Name: {{ $json.contact_firstname }}\nLast Name: {{ $json.contact_lastname }}\nEmail: {{ $json.contact_email }}\nCompany: {{ $json.contact_company }}\n\nCreate a personalized follow-up email for this stalled deal.",
        "options": {
          "systemMessage": "You are an AI B2B Sales Follow-Up Agent.\n\nCreate a professional follow-up email for a stalled sales deal.\n\nUse ONLY the information provided in the user message.\n\nDo not invent:\n- contact names\n- company facts\n- previous conversations\n- pricing\n- discounts\n- promises\n- meeting dates\n\nThe deal has been marked STALLED because it has been inactive for 5 or more days.\n\nCreate a concise, human-sounding follow-up email.\n\nThe email should:\n- Mention the deal/company naturally.\n- Reference the current deal stage when useful.\n- Politely ask for an update.\n- Suggest a simple next step.\n- Avoid sounding like spam.\n\nTone:\nProfessional, friendly, concise and helpful.\n\nKeep the email between 80 and 140 words.\n\nReturn ONLY valid JSON:\n\n{\n  \"subject\": \"\",\n  \"email_body\": \"\",\n  \"reason_for_followup\": \"\",\n  \"suggested_next_step\": \"\"\n}"
        }
      },
