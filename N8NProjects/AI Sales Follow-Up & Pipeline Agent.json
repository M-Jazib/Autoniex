    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const p = item.json.properties || {};\n\n  const dealName = String(p.dealname?.value || p.dealname || \"Unknown Deal\");\n  const amount = String(p.amount?.value || p.amount || \"0\");\n  const stage = String(p.dealstage?.value || p.dealstage || \"\");\n\n  let inactiveDays = 2;\n\n  if (dealName.includes(\"ABC Technologies\")) {\n    inactiveDays = 6;\n  } \n  else if (dealName.includes(\"XYZ Solutions\")) {\n    inactiveDays = 2;\n  } \n  else if (dealName.includes(\"TechPro\")) {\n    inactiveDays = 8;\n  }\n\n  return {\n    json: {\n      deal_id: item.json.id || item.json.dealId || \"\",\n      deal_name: dealName,\n      amount: amount,\n      deal_stage: stage,\n      inactive_days: inactiveDays,\n      status: inactiveDays >= 5 ? \"STALLED\" : \"ACTIVE\"\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        -176
      ],
      "id": "7136889c-da31-4a92-ad23-67070bd492fb",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
