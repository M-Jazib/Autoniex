    {
      "parameters": {
        "jsCode": "const contact = $json;\n\nconst deal = $('Code in JavaScript').item.json;\n\nconst emailIdentity = (contact.identities || []).find(\n  x => x.type === 'EMAIL'\n);\n\nreturn [{\n  json: {\n    deal_id: deal.deal_id,\n    deal_name: deal.deal_name,\n    amount: deal.amount,\n    deal_stage: deal.deal_stage,\n    inactive_days: deal.inactive_days,\n    status: deal.status,\n\n    contact_id: contact.vid || contact.id || \"\",\n    contact_firstname: contact.properties?.firstname?.value || \"\",\n    contact_lastname: contact.properties?.lastname?.value || \"\",\n    contact_email:\n      contact.properties?.email?.value ||\n      emailIdentity?.value ||\n      \"\",\n\n    contact_company: contact.properties?.company?.value || \"\"\n  }\n}];"
      },
