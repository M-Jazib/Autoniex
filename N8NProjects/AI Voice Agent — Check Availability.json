    {
      "parameters": {
        "jsCode": "const dateInput = $json.body?.date;\nconst timeInput = $json.body?.time;\n\nif (!dateInput) {\n  throw new Error(\"Date is missing from the webhook request.\");\n}\n\nif (!timeInput) {\n  throw new Error(\"Time is missing from the webhook request.\");\n}\n\nconst currentYear = new Date().getFullYear();\n\n// Remove ordinal suffixes:\n// 1st September → 1 September\n// September 1st → September 1\nlet cleanDate = String(dateInput)\n  .trim()\n  .replace(/(\\d+)(st|nd|rd|th)/gi, '$1');\n\n// Parse date\nlet parsedDate = new Date(`${cleanDate}, ${currentYear}`);\n\nif (isNaN(parsedDate.getTime())) {\n  throw new Error(`Invalid date received: ${dateInput}`);\n}\n\n// Convert time\nfunction convertTime(timeString) {\n  const cleanTime = String(timeString).trim();\n\n  const match = cleanTime.match(\n    /^(\\d{1,2})(?::(\\d{2}))?\\s*(AM|PM)$/i\n  );\n\n  if (!match) {\n    throw new Error(`Invalid time received: ${timeString}`);\n  }\n\n  let hour = parseInt(match[1], 10);\n  const minute = match[2] || '00';\n  const period = match[3].toUpperCase();\n\n  if (hour < 1 || hour > 12) {\n    throw new Error(`Invalid hour received: ${timeString}`);\n  }\n\n  if (period === 'PM' && hour !== 12) {\n    hour += 12;\n  }\n\n  if (period === 'AM' && hour === 12) {\n    hour = 0;\n  }\n\n  return `${String(hour).padStart(2, '0')}:${minute}`;\n}\n\nconst normalizedTime = convertTime(timeInput);\n\nconst year = parsedDate.getFullYear();\nconst month = String(parsedDate.getMonth() + 1).padStart(2, '0');\nconst day = String(parsedDate.getDate()).padStart(2, '0');\n\nconst normalizedDate = `${year}-${month}-${day}`;\n\nconst startDateTime = `${normalizedDate}T${normalizedTime}:00`;\n\nreturn {\n  json: {\n    ...$json,\n\n    normalized_date: normalizedDate,\n\n    normalized_time: normalizedTime,\n\n    start_datetime: startDateTime\n  }\n};"
      },
