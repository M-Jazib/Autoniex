# ─── Google Analytics 4 ───────────────────────────────────────────────────────
# Required for GA4 tracking. Get your Measurement ID from:
# Google Analytics → Admin → Data Streams → your stream → Measurement ID
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ─── Meta Pixel ───────────────────────────────────────────────────────────────
# Required for Facebook/Instagram ad tracking and conversion optimization.
# Get your Pixel ID from: Meta Business Suite → Events Manager → your Pixel → Settings
NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXXX

# ─── Hostinger Deployment Note ───────────────────────────────────────────────
# Set BOTH variables in Hostinger App Hosting environment variables:
# Hostinger Panel → Hosting → your app → Environment Variables → Add Variable
